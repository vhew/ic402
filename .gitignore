# Patch backup files (created by scripts/patch-local.sh during local deploy).
# These hold the pristine MAINNET source while it is temporarily testnet-patched.
# A failed restore can leave testnet-patched content behind — never commit these.
*.local-bak
example/main.mo.local-bak

