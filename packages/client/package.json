{
  "name": "@ic402/client",
  "version": "2.17.6",
  "description": "TypeScript client SDK for ic402-enabled ICP canisters",
  "license": "Apache-2.0",
  "author": "Vaughn Hew",
  "repository": {
    "type": "git",
    "url": "https://github.com/vhew/ic402.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ic402",
    "x402",
    "payment",
    "icp",
    "internet-computer",
    "typescript",
    "sdk",
    "evm",
    "icrc2",
    "micropayment",
    "streaming",
    "eip-3009"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@icp-sdk/core": "6.1.0",
    "cborg": "6.1.3",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@icp-sdk/core": "6.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
